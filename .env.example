# Copy to .env and adjust. Never commit the real .env.

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=papers

# --- Ollama ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b  # M8.3: quality-first pick (richer ranked answers; 0.6b is ~2x faster on CPU)

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- OpenAlex data source (polite pool; no API key needed) ---
OPENALEX_BASE_URL=https://api.openalex.org/works
OPENALEX_MAILTO=shayanx13@gmail.com

# --- Data paths ---
DATA_RAW=data/raw
DATA_INTERIM=data/interim
DATA_PROCESSED=data/processed
